# ============================================================================
# Supabase Environment Configuration Template
# ============================================================================
# IMPORTANT SECURITY NOTICE:
# - Only public, non-privileged keys belong in client-facing applications.
# - NEVER commit your real .env file with production credentials.
# - NEVER include the SUPABASE_SERVICE_ROLE_KEY in frontend code.
# ============================================================================

# Supabase Project URL (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for client use; protected by Postgres Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Target Tenant Slug for Public Website Context
VITE_DEFAULT_TENANT_SLUG=aromica-cafe
